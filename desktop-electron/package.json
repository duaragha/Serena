{
  "name": "serena-desktop",
  "version": "0.1.0",
  "description": "Serena desktop shell",
  "main": "main.js",
  "author": "Raghav",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "clean:intermediate": "bash scripts/clean-intermediate.sh",
    "dist:appimage": "npm run build:sidecar && electron-builder --linux AppImage",
    "dist:linux": "npm run build:sidecar && electron-builder --linux AppImage deb",
    "smoke:appimage": "node tests/smoke-appimage.js",
    "release:linux": "npm run build:sidecar && electron-builder --linux AppImage --publish always",
    "release:win": "powershell -ExecutionPolicy Bypass -File windows/build-win.ps1 -Publish",
    "rollback:keep": "bash scripts/keep-rollback.sh",
    "rollback:list": "bash scripts/keep-rollback.sh --list"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.0.12",
    "js-yaml": "^4.1.0"
  },
  "build": {
    "appId": "ai.serena.desktop",
    "productName": "Serena",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime.js",
      "package.json",
      "build/icon.png",
      "menu.js",
      "updates.js"
    ],
    "extraResources": [
      {
        "from": "build/sidecar/serena-web-sidecar",
        "to": "sidecar"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "serena",
      "artifactName": "Serena-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Serena",
          "Comment": "Serena desktop assistant",
          "StartupWMClass": "Serena"
        }
      },
      "icon": "build/icon.png"
    },
    "deb": {
      "priority": "optional",
      "recommends": [
        "libappindicator3-1"
      ]
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "duaragha",
        "repo": "Serena",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
