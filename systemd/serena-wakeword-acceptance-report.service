[Unit]
Description=Serena frozen wake-word acceptance report
ConditionPathExists=%h/.config/serena/wakeword-acceptance.json
ConditionPathExists=%h/.local/state/serena/wakeword-acceptance.sqlite3

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/serena
ExecStart=%h/Documents/Projects/serena/voice/.venv-wake/bin/python -m voice.call.wakeword_harness report --manifest %h/.config/serena/wakeword-acceptance.json --db %h/.local/state/serena/wakeword-acceptance.sqlite3 --output %h/.local/state/serena/wakeword-acceptance-report.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/serena
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
