[Unit]
Description=Serena local dot-field state and amplitude bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/serena
ExecStart=%h/Documents/Projects/serena/.venv/bin/python -u -m voice.brain_bridge
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# It opens a unix socket under ~/.local/state/serena and writes voice state
# into ~/.config/serena. Under the old arrangement it only ever ran as a child
# of serena-dot-overlay, which granted these; standalone it died on its first
# line with "Read-only file system" every two seconds.
ReadWritePaths=%h/.config/serena %h/.cache/serena %h/.local/state/serena
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
