[Unit]
Description=Serena wake-word threshold report
ConditionPathExists=%h/.local/state/serena/wakeword-calibration.sqlite3

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/serena
ExecStart=%h/Documents/Projects/serena/voice/.venv-wake/bin/python -m voice.call.wakeword_harness report
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/serena
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
