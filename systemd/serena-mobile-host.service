[Unit]
Description=Serena same-origin mobile chat and call host
After=network-online.target serena-brain.service
Wants=network-online.target serena-brain.service
ConditionPathExists=%h/Documents/Projects/serena/mobile/dist/index.html

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/serena
Environment=PYTHONUNBUFFERED=1
Environment=SERENA_CALL_TRUST_IDMAPPED_SYSTEM=1
# Remote on purpose: the PC hosts the voice so the phone and laptop can
# reach Serena while this machine is off. Measured 2026-08-21 the remote
# is 0.10s p50 over 15 runs, so it is not slow, it STALLS occasionally.
# The guard is the first-audio deadline below, not moving off the PC.
Environment=SERENA_CALL_TTS_BACKEND=remote
# Give up on a stalled remote in 1.5s and speak locally instead. The
# inference timeout is 60s, which left him in silence for nearly a
# minute while her finished reply sat on screen.
Environment=SERENA_CALL_TTS_REMOTE_FIRST_AUDIO_TIMEOUT=1.5
Environment=SERENA_CALL_TTS_REMOTE_URL=https://pc.tail4d6220.ts.net:8812
Environment=SERENA_CALL_TTS_REMOTE_FALLBACK=1
Environment=SERENA_CALL_POCKET_PYTHON=%h/Documents/Projects/serena/.venv-pocket/bin/python
Environment=SERENA_CALL_POCKET_VOICE=anna
Environment=HF_HOME=%h/.cache/serena/pocket-tts
Environment=SERENA_CALL_BACKCHANNEL_DELAY_MS=0
Environment=SERENA_CALL_WHISPER_MODEL=%h/Documents/Projects/serena/voice/models/faster-whisper-small.en
Environment=SERENA_DESK_EOU_PARTIAL_TRIGGER_MS=240
Environment=SERENA_DESK_EOU_MIN_MS=480
Environment=SERENA_DESK_EOU_BASE_MS=800
Environment=SERENA_DESK_EOU_MAX_MS=2400
Environment=SERENA_CALL_FIRST_CLAUSE_CHARS=12
Environment=SERENA_CALL_FIRST_CLAUSE_HARD_CHARS=56
ExecStart=%h/Documents/Projects/serena/.venv/bin/python -u -m core.mobile_host --host 127.0.0.1 --port 8767
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
# No filesystem sandbox. These units spawn real agent CLIs that write
# transcripts, rollouts, worktrees and project files all over the home
# directory, so a read-only root with a whitelist could only ever be a
# list of paths someone had already been bitten by. ProtectControlGroups
# is out too: idle panes reclaim their own memory through cgroup knobs.
# The kernel-level hardening below stays, since none of it restricts what
# an agent may read or write.
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
