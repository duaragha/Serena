# Optional local voice overrides.
# Models are local and the brain transport stays on the Serena control plane.

SERENA_CALL_TTS_BACKEND=pocket
SERENA_CALL_POCKET_VOICE=anna
SERENA_CALL_POCKET_LANGUAGE=english
SERENA_CALL_POCKET_THREADS=2
SERENA_CALL_POCKET_QUANTIZE=true
SERENA_CALL_VOICE_SPEED=1.2
SERENA_DESK_VAD_SILENCE_MS=650
SERENA_DESK_MAX_UTTERANCE_MS=30000
