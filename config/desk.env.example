# Optional local voice overrides.
# Models are local and the brain transport stays on the Serena control plane.

SERENA_CALL_TTS_BACKEND=pocket
# Alba is Pocket's casual English profile and clears Serena's local realtime
# gate. Run `python -m voice.call.voice_quality` before changing this choice.
SERENA_CALL_POCKET_VOICE=alba
SERENA_CALL_POCKET_LANGUAGE=english
SERENA_CALL_POCKET_THREADS=2
SERENA_CALL_POCKET_QUANTIZE=true
# Used by the Kokoro fallback. Normal speed keeps conversational phrasing from
# sounding rushed.
SERENA_CALL_VOICE_SPEED=1.0
# Adaptive turn taking starts a speculative transcript at the first pause.
# Complete thoughts can commit quickly, unknown endings get 800 ms, and
# incomplete thoughts can keep the floor for 2.4 seconds.
SERENA_DESK_EOU_PARTIAL_TRIGGER_MS=240
SERENA_DESK_EOU_MIN_MS=480
SERENA_DESK_EOU_BASE_MS=800
SERENA_DESK_EOU_MAX_MS=2400
SERENA_DESK_MAX_UTTERANCE_MS=30000
# Keep the microphone live during thinking and playback. Sustained speech
# interrupts; short noise stays local. Set to 0 for the old half-duplex loop.
SERENA_DESK_BARGE_IN=1
SERENA_DESK_BARGE_THINKING_SUSTAIN_MS=160
SERENA_DESK_BARGE_SUSTAIN_MS=320
# First brain clause can reach TTS before a long opening sentence finishes.
SERENA_CALL_FIRST_CLAUSE_CHARS=12
SERENA_CALL_FIRST_CLAUSE_HARD_CHARS=56
