# Optional resident brain overrides. Model routing lives in serena-policy.json.
# Do not add ANTHROPIC_API_KEY or another metered provider credential.

# Manual model override for every brain turn. Keep auto for policy routing.
SERENA_BRAIN_MODEL_OVERRIDE=auto
# Claude session bootstrap aliases remain for compatibility. The shared policy
# selects the actual model for each turn.
SERENA_BRAIN_MODEL=sonnet
SERENA_BRAIN_VOICE_MODEL=sonnet
SERENA_BRAIN_REFLEX_MODEL=haiku
SERENA_BRAIN_PORT=8377
SERENA_BRAIN_STREAM_TRANSPORT=unix
