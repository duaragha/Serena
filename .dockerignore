# The Windows mobile daemon receives an explicit source-only build context.
# Everything stays excluded unless it is required by Dockerfile.serena.
*

!Dockerfile.serena
!cli.py
!VoiceReminder.txt

!core/
core/*
!core/*.py
!core/mcp/
core/mcp/*
!core/mcp/*.py

!chats/
chats/*
!chats/*.py

!ui/
ui/*
!ui/*.py

!memory/
memory/*
!memory/*.py

!knowledge/
knowledge/*
!knowledge/*.py

!voice/
voice/*
!voice/__init__.py
!voice/call/
voice/call/*
!voice/call/*.py
!voice/call/vocabulary.txt

!static/
static/*
!static/*
